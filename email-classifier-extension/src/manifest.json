 {
  "manifest_version": 3,
  "name": "Email Classifier Extension",
  "version": "1.0",
  "description": "Classify emails and detect CAD URLs using a backend API.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:5000/*"],  
  "action": {
    "default_popup": "UI/popup.html",
    "default_title": "Email Classifier"
  }
}